# JmdEditor 导出服务配置。第一次启动时会复制成 jmd-server.env，之后改 jmd-server.env，在宝塔里重启项目生效。
# 路径都相对于本目录（start.sh 会先切换到这里）。

# 监听地址。由宝塔的 Nginx 反向代理时保持 127.0.0.1，不要直接对外开放端口。
JMD_ADDR=127.0.0.1:8787

# 通过宝塔 Nginx 反向代理时设为 1，限流才能按真实用户 IP 计算。
JMD_TRUST_PROXY=1

# PDF 导出用的中日文字体（已随包附带）。
JMD_FONT_DIRS=./fonts

# 浏览器版编辑器。不需要网页版可以留空。
JMD_STATIC=./web

# 同时进行的导出数量，默认按 CPU 核数（最多 8）。
#JMD_MAX_CONCURRENT=2

# 单次导出超时秒数。
JMD_EXPORT_TIMEOUT_SECS=60

# 每个 IP 每分钟最多请求次数，0 为不限。
JMD_RATE_PER_MIN=60

# 允许跨域调用的网页地址，多个用逗号分隔。小程序不需要填。
#JMD_CORS_ORIGINS=https://md.example.com

# 日志级别：error / warn / info / debug
RUST_LOG=info
