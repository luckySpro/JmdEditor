@import '../index/index.wxss';

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 44rpx 28rpx 36rpx;
}
.logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #2f5bd3;
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 112rpx;
  text-align: center;
  margin-bottom: 8rpx;
}
.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1d23;
}
.tagline {
  font-size: 28rpx;
  color: #3a404b;
  text-align: center;
}
.small {
  font-size: 24rpx;
}
.body {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2a2f38;
}
.features {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.feature {
  display: flex;
  gap: 12rpx;
}
.dot {
  color: #2f5bd3;
  font-size: 28rpx;
  line-height: 1.6;
}
.hint {
  display: block;
  margin: 8rpx 0 12rpx;
  line-height: 1.5;
}
.download {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #eef0f3;
}
.download-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.platform {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1d23;
}
.link {
  word-break: break-all;
}
.note {
  display: block;
  margin-top: 12rpx;
  line-height: 1.5;
}
